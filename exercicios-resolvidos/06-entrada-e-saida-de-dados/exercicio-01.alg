// Gabarito Oficial — Capítulo: 06-entrada-e-saida-de-dados — Exercício 1

algoritmo "Dados do Produto"
var
   nome: caractere
   preco: real

inicio
   escreva("Digite o nome do produto: ")
   leia(nome)
   escreva("Digite o preco do produto: ")
   leia(preco)

   escreval("O produto ", nome, " custa R$ ", preco)
fimalgoritmo
