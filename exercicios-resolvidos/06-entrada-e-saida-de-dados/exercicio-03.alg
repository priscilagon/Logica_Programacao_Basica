// Gabarito Oficial — Capítulo: 06-entrada-e-saida-de-dados — Exercício 3

algoritmo "Area do Triangulo"
var
   base, altura, area: real

inicio
   escreva("Digite a base do triangulo: ")
   leia(base)
   escreva("Digite a altura do triangulo: ")
   leia(altura)

   area <- (base * altura) / 2
   escreval("A area do triangulo e: ", area)
fimalgoritmo
