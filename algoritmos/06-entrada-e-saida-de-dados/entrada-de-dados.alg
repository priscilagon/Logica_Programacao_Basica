// Apostila de Lógica de Programação (VisuAlg)
// Capítulo: 06-entrada-e-saida-de-dados

algoritmo "Entrada de Dados"
var
   nome: caractere
   idade: inteiro

inicio
   escreva("Digite seu nome: ")
   leia(nome)
   escreva("Digite sua idade: ")
   leia(idade)
   escreval("Ola, ", nome, "! Voce tem ", idade, " anos.")
fimalgoritmo
