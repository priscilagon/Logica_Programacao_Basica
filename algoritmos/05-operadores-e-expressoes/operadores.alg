// Apostila de Lógica de Programação (VisuAlg)
// Capítulo: 05-operadores-e-expressoes

algoritmo "Operadores"
var
   a, b, resultado: inteiro

inicio
   a <- 10
   b <- 3
   resultado <- (a + b) * 2
   escreva("Resultado: ", resultado)
   escreva("Divisao inteira: ", a div b)
   escreva("Resto: ", a mod b)
fimalgoritmo
