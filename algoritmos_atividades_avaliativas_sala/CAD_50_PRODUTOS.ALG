Algoritmo "CAD_50_PRODUTOS"
// LOGICA DE PROGRAMACAO BASICA
// QUESTAO 02
// Data atual : 21/09/2026
Var
   NOME:VETOR[1..50] DE CARACTERE
   CUSTO, PRECO, LUCRO_PROD: VETOR[1..5] DE REAL
   I:INTEIRO

Inicio
   PARA I DE 1 ATE 50 FACA
      ESCREVA("NOME DO PRODUTO: ", I, ": ")
      LEIA(NOME[I])

      ESCREVA("CUSTO: ")
      LEIA(CUSTO[I])

      ESCREVA("PRECO DE VENDA: ")
      LEIA(PRECO[I])

      // CALCULO DO PERCENTUAL DE LUCRO
      LUCRO_PROD[I] <- ((PRECO[I] - CUSTO[I])) / CUSTO[I] * 100
   FIMPARA
   ESCREVAL("A) PRODUTO COM LUCRO 10%: ")
   PARA I DE 1 ATE 50 FACA
      SE (LUCRO_PROD[I] < 10) ENTAO
         ESCREVAL(NOME[I])
      FIMSE
   FIMPARA

   ESCREVAL("B) PRODUTO COM LUCRO ENTRE 10% E 30%: ")
   PARA I DE 1 ATE 50 FACA
      SE (LUCRO_PROD[I] >= 10) E (LUCRO_PROD[I] <= 30) ENTAO
         ESCREVAL(NOME[I])
      FIMSE
   FIMPARA

   ESCREVAL("C) PRODUTO COM LUCRO MAIOR QUE 30%: ")
   PARA I DE 1 ATE 50 FACA
      SE (LUCRO_PROD[I] > 30) ENTAO
         ESCREVAL(NOME[I])
      FIMSE
   FIMPARA
Fimalgoritmo