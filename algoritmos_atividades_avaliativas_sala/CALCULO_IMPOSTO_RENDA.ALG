Algoritmo "CALCULO_IMPOSTO_RENDA"
// RESPOSTA DA ATIVIDADE AVALIATIVA 08
//LÓGICA DE PROGRAMAÇÃO BÁSICA
//DATA: 10/09/2026
Var
  // DECLARAÇÃO DAS VARIÁVEIS
   SALARIO_MINIMO, RENDA_MENSAL, DESCONTO, RENDA_LIQUIDA:REAL
   IMPOSTO, QTD_SALARIOS : REAL
   CPF : CARACTERE
   NUM_DEPENDENTES, I : INTEIRO

Inicio
   // SOLICITA O VALOR ATUAL DO SALÁRIO MÍNIMO FORA DO LAÇO (POIS É O MESMO PARA TODOS)
   ESCREVAL("INFORME O VALOR ATUAL DO SALÁRIO MÍNIMO: ")
   LEIA(SALARIO_MINIMO)

   // INICIA UM LAÇO DE REPETIÇÃO QUE VAI DE 1 ATÉ 10 (PARA OS 10 CONTRIBUINTES)
   PARA I DE 1 ATE 10 FACA
      ESCREVAL("--- DADOS DO CONTRIBUINTE ", I, " ---")

      // LEITURA DO CPF DO CONTRIBUINTE
      ESCREVAL("DIGITE O CPF: ")
      LEIA(CPF)

      // LEITURA DA QUANTIDADE DE DEPENDENTES
      ESCREVAL("DIGITE O NÚMERO DE DEPENDENTES: ")
      LEIA(NUM_DEPENDENTES)

      // LEITURA DA RENDA MENSAL DO CONTRIBUINTE
      ESCREVAL("DIGITE A RENDA MENSAL: ")
      LEIA(RENDA_MENSAL)

      // CALCULA O DESCONTO: 5% (0.05) DO SALÁRIO MÍNIMO MULTIPLICADO PELO Nº DE DEPENDENTES
      DESCONTO <- NUM_DEPENDENTES * (SALARIO_MINIMO * 0.05)

      // CALCULA A RENDA LÍQUIDA SUBTRAINDO O DESCONTO DA RENDA MENSAL
      RENDA_LIQUIDA <- RENDA_MENSAL - DESCONTO

      // DESCOBRE QUANTOS SALÁRIOS MÍNIMOS A RENDA LÍQUIDA REPRESENTA (PARA OLHAR NA TABELA)
      QTD_SALARIOS <- RENDA_LIQUIDA / SALARIO_MINIMO

      // VERIFICA EM QUAL FAIXA DA ALÍQUOTA A RENDA LÍQUIDA SE ENCAIXA
      SE (QTD_SALARIOS <= 2) ENTAO
         // ATÉ 2 SALÁRIOS MÍNIMOS: ISENTO
         IMPOSTO <- 0
      SENAO
         SE (QTD_SALARIOS <= 3) ENTAO
            // DE 2 A 3 SALÁRIOS MÍNIMOS: 5%
            IMPOSTO <- RENDA_LIQUIDA * 0.05
         SENAO
            SE (QTD_SALARIOS <= 5) ENTAO
               // DE 3 A 5 SALÁRIOS MÍNIMOS: 10%
               IMPOSTO <- RENDA_LIQUIDA * 0.10
            SENAO
               SE (QTD_SALARIOS <= 7) ENTAO
                  // DE 5 A 7 SALÁRIOS MÍNIMOS: 15%
                  IMPOSTO <- RENDA_LIQUIDA * 0.15
               SENAO
                  // ACIMA DE 7 SALÁRIOS MÍNIMOS: 20%
                  IMPOSTO <- RENDA_LIQUIDA * 0.20
               FIMSE
            FIMSE
         FIMSE
      FIMSE

      // EXIBE OS RESULTADOS PARA O CONTRIBUINTE ATUAL NA TELA
      ESCREVAL("CPF: ", CPF)
      ESCREVAL("RENDA LÍQUIDA: R$ ", RENDA_LIQUIDA)
      ESCREVAL("IMPOSTO A PAGAR: R$ ", IMPOSTO)
      ESCREVAL("-----------------------------------")
      ESCREVAL("") // PULA UMA LINHA PARA ORGANIZAR O VISUAL

   FIMPARA // RETORNA AO INÍCIO DO LAÇO PARA O PRÓXIMO CONTRIBUINTE, ATÉ DAR 10

Fimalgoritmo