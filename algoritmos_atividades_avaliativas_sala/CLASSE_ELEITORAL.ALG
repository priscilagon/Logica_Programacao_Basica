Algoritmo "CLASSE_ELEITORAL"
// LOGICA DE PROGRAMAÇÃO BASICA
// Data atual  : 09/09/2026
Var

   IDADE:INTEIRO

Inicio
   ESCREVA("DIGITE A IDADE DA PESSOA: ")
   LEIA(IDADE)

   SE (IDADE < 16) ENTAO
      ESCREVAL("SITUAÇÃO: NÃO PODE VOTAR!")
   SENAO
      SE (IDADE >= 16) E (IDADE < 18) OU (IDADE >= 70) ENTAO
         ESCREVAL("SITUAÇÃO: VOTO FACULTATIVO (OPCIONAL).")
      SENAO
         ESCREVAL("SITUAÇÃO: VOTO OBRIGATORIO.")
      FIMSE
   FIMSE
Fimalgoritmo