Algoritmo "VALIDAR_SENHA"
// LOGICA DE PROGRAMAÇÃO BÁSICA
// Data atual  : 10/09/2026
// ESTRITURA DE REPETIÇÃO REPITA...ATE
Var
   SENHA:INTEIRO

Inicio
   REPITA
      ESCREVA("DIGITE A SENHA (1234): ")
      LEIA(SENHA)
   ATE (SENHA = 1234)

   ESCREVAL("SENHA CORRETA! ACESSO LIBERADO.")
Fimalgoritmo