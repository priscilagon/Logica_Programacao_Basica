Algoritmo "USO_CONTANTE"
// Data atual  : 04/09/2026
PI = 3.14159

Var
   // Seção de Declarações das variáveis
   raio, area: real

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   escreva("Digite o raio: ")
   leia(raio)
   area <- PI * raio * raio
   escreva("A area do circulo e: ", area)

Fimalgoritmo